{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    // Imports use explicit .ts specifiers so every module runs directly under `node file.ts`
    // (Node 22+ strips types natively) without a build step or loader. esbuild — what Wrangler
    // bundles with — resolves them the same way. Requires noEmit, which is set below.
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
